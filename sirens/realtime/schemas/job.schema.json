{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "job",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "ready",
        "error",
        "cancelled"
      ]
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "asset_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "meldung": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "feld": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "error",
            "meldung",
            "feld"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "session_id",
    "state",
    "progress",
    "asset_id",
    "error"
  ],
  "additionalProperties": false
}
