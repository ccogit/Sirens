{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "telemetry",
  "type": "object",
  "properties": {
    "available": {
      "type": "boolean"
    },
    "device": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "vram_total_bytes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "vram_used_bytes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "compute_percent": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "temperature_c": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -50,
          "maximum": 150
        },
        {
          "type": "null"
        }
      ]
    },
    "queue_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "deadline_misses": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "underruns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "available",
    "device",
    "vram_total_bytes",
    "vram_used_bytes",
    "compute_percent",
    "temperature_c",
    "queue_depth",
    "deadline_misses",
    "underruns"
  ],
  "additionalProperties": false
}
