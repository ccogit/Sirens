{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "asset",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "kind": {
      "enum": [
        "source",
        "cache",
        "recording"
      ]
    },
    "sample_rate": {
      "type": "integer",
      "minimum": 8000,
      "maximum": 192000
    },
    "channels": {
      "enum": [
        2
      ]
    },
    "nframes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "kind",
    "sample_rate",
    "channels",
    "nframes"
  ],
  "additionalProperties": false
}
