{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "capability",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "mock": {
      "type": "boolean"
    },
    "available": {
      "type": "boolean"
    },
    "mode": {
      "enum": [
        "streaming",
        "lookahead",
        "offline"
      ]
    },
    "sample_rates": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 8000,
        "maximum": 192000
      },
      "maxItems": 16,
      "minItems": 1
    },
    "channels": {
      "enum": [
        2
      ]
    },
    "context_frames": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hop_frames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "latency_frames": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
          },
          "min": {
            "type": "number",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "max": {
            "type": "number",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "default": {
            "type": "number",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "min",
          "max",
          "default"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "vram_peak_bytes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "enum": [
            "unknown"
          ]
        }
      ]
    },
    "device": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "model_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "id",
    "mock",
    "available",
    "mode",
    "sample_rates",
    "channels",
    "context_frames",
    "hop_frames",
    "latency_frames",
    "controls",
    "vram_peak_bytes",
    "device",
    "license",
    "model_revision"
  ],
  "additionalProperties": false
}
