{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "beatgrid",
  "type": "object",
  "properties": {
    "bpm": {
      "type": "number",
      "minimum": 1,
      "maximum": 1000
    },
    "beat0": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bar0": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "tempo_map": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_frame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "bpm": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "source_frame",
          "bpm"
        ],
        "additionalProperties": false
      },
      "maxItems": 4096
    }
  },
  "required": [
    "bpm",
    "beat0",
    "bar0",
    "confidence"
  ],
  "additionalProperties": false
}
