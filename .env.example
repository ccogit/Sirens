# SoundCloud-Zugang für den Upload aus Sirens.
# CLIENT_ID und CLIENT_SECRET stammen aus der eigenen App (soundcloud.com/you/apps, braucht Artist Pro).
# Danach einmal im Projektordner ausführen:  py -3.11 scripts/soundcloud_auth.py
# Das Skript trägt ACCESS_TOKEN und REFRESH_TOKEN selbst ein; nicht von Hand setzen.
SOUNDCLOUD_CLIENT_ID=change-me
SOUNDCLOUD_CLIENT_SECRET=change-me
SOUNDCLOUD_ACCESS_TOKEN=
SOUNDCLOUD_REFRESH_TOKEN=

# Kick-Tausch im Live Lab: Befehl, der einen Song in Schlagzeug und Rest trennt (JSON-Liste).
# Platzhalter: {ein} = Datei, {ein_ordner} und {ein_name} = ihr Ordner und Name, {aus} = Zielordner.
# Im Zielordner müssen danach `drums` und `no_drums` als FLAC oder WAV liegen (so wie bei `demucs --two-stems drums`).
# Ohne diese Zeile nimmt Sirens ein installiertes demucs; gibt es keines, ist der Kick-Tausch abgeschaltet.
# Beispiel mit einem Container, der demucs enthält:
# SIRENS_STEMS_CMD=["podman","run","--rm","--network","none","-v","{ein_ordner}:/ein:ro","-v","{aus}:/aus","mein-demucs-abbild","python","-m","demucs","--two-stems","drums","--flac","-o","/aus","/ein/{ein_name}"]

# KI Stem Studio im Live Lab: Python mit torch und demucs, und – für das Instrument-Labor – eines mit basic-pitch.
# Einrichtung siehe docs/stem-studio.md. Der Dienst liest alle SIRENS_-Zeilen dieser Datei beim Start.
# SIRENS_STEMS_PYTHON=C:\Pfad\zu\Sirens\.venv-stems\Scripts\python.exe
# SIRENS_STEMS_PITCH_PYTHON=C:\Pfad\zu\Sirens\.venv-pitch\Scripts\python.exe

# Echtzeit-Labor v1: standardmäßig aus; Mock nur für lokale Entwicklung.
SIRENS_RT_ENABLED=aus
# SIRENS_RT_DIR=C:\Sirens-Daten\realtime
# Standard: DATA_DIR/realtime (Cache und Sitzungen, nie Musikordner).
# SIRENS_RT_MOCK=aus

# RT-Modelle: Installierte Umgebungen werden automatisch gefunden (Ordner .venv-<modell> oder die
# Messumgebung .venv-spike-<modell> im Sirens-Ordner, siehe python_dirs in workers/*/manifest.json).
# Ein Eintrag ist nur nötig, wenn eine Umgebung woanders liegt, z. B.:
# SIRENS_RT_RAVE_PYTHON=D:\Modelle\rave\Scripts\python.exe
# Automatische Suche abschalten:
# SIRENS_RT_AUTODETECT=aus

# RT: konservative GPU-Reserve (Bytes, Standard 2,5 GiB)
SIRENS_RT_RESERVE_BYTES=2684354560
